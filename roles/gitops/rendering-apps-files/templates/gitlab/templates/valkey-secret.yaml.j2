{# Password of the Valkey "default" user, shared by the valkey dependency and the GitLab CR (global.redis.auth) #}
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-valkey
  namespace: {{ dsc.gitlab.namespace }}
  annotations:
    avp.kubernetes.io/remove-missing: "true"
type: Opaque
stringData:
  password: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/gitlab/values#valkeyPassword>
