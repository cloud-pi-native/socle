apiVersion: v1
kind: Secret
metadata:
  name: velero-s3-credentials
  annotations:
    avp.kubernetes.io/remove-missing: "true"
type: Opaque
stringData:
  # Format expected by Velero's AWS plugin (credentials.existingSecret): AWS CLI style
  # credentials file under the "cloud" key. Reuses the same access/secret key as
  # vault-backup-s3-credentials (templates/vault/templates/secret-vault-backup.j2),
  # already pushed empty via the "global" app (dsc.global.backup.s3) instead of
  # inventing a new secret mechanism for Velero.
  cloud: |
    [default]
    aws_access_key_id=<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3AccessKey}>
    aws_secret_access_key=<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3SecretKey}>
