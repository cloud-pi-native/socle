vault:
{% if dsc.global.platform == "openshift" %}
  global:
    openshift: true

cpn-ansible-job:
  global:
    platform: openshift 
{% elif dsc.global.platform == "kubernetes" %}
  injector:
    securityContext:
      pod:
        runAsNonRoot: true
        runAsGroup: 1000
        runAsUser: 100
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      container:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
  
  server:
    statefulSet:
      securityContext:
        pod:
          runAsNonRoot: true
          runAsGroup: 1000
          runAsUser: 100
          fsGroup: 1000
          seccompProfile:
            type: RuntimeDefault
        # No IPC_LOCK needed: the chart forces disable_mlock = true in the rendered server config
        container:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
{% endif %}
