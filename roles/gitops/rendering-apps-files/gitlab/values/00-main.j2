installCertmanager: true

registry:
  enabled: false

nginx-ingress:
  enabled: false

gitlab:
  webservice:
    registry:
      enabled: false
{% if dsc.global.metrics.enabled %}
    metrics:
      serviceMonitor:
        enabled: true
{% if dsc.global.metrics.additionalLabels is defined %} 
        additionalLabels:
{% for key, value in dsc.global.metrics.additionalLabels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endif %}
  sidekiq:
    registry:
      enabled: false
{% if dsc.global.metrics.enabled %}
    metrics:
      podMonitor:
        enabled: true
{% if dsc.global.metrics.additionalLabels is defined %} 
        additionalLabels:
{% for key, value in dsc.global.metrics.additionalLabels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endif %}
  unicorn:
    registry:
      enabled: false
  gitaly:
    priorityClassName: gitlab-gitaly
    resources:
      requests:
        cpu: 1000m
        memory: 2Gi
      limits:
        cpu: 1000m
        memory: 2Gi
    securityContext:
      fsGroupChangePolicy: OnRootMismatch
{% if dsc.global.metrics.enabled %}
    metrics:
      serviceMonitor:
        enabled: true
{% if dsc.global.metrics.additionalLabels is defined %} 
        additionalLabels:
{% for key, value in dsc.global.metrics.additionalLabels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endif %}
    persistence:
      size: "{{ dsc.gitlab.pvcGitalySize }}"
  gitlab-exporter:
{% if dsc.global.metrics.enabled %}
    metrics:
      serviceMonitor:
        enabled: true
{% if dsc.global.metrics.additionalLabels is defined %} 
        additionalLabels:
{% for key, value in dsc.global.metrics.additionalLabels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endif %}
  kas:
    enabled: false
{% if dsc.global.metrics.enabled %}
    metrics:
      serviceMonitor:
        enabled: true
{% if dsc.global.metrics.additionalLabels is defined %} 
        additionalLabels:
{% for key, value in dsc.global.metrics.additionalLabels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endif %}
  toolbox:
    backups:
      cron:
        enabled: {{ dsc.global.backup.gitlab.enabled }}
{% if dsc.global.backup.gitlab.enabled %}
{#
  With external object storage (bucketPrefix), backup-utility copies every bucket object by object
  before building the tar. The artifacts bucket is too large and changes too fast for that
  (objects expiring mid-copy make s3cmd fail with NoSuchKey): skip it by default.
#}
{% set gitlab_backup_external_storage = (dsc.global.bucketPrefix | default('', true) | trim) != '' %}
        schedule: "{{ dsc.global.backup.gitlab.cron }}"
{% if dsc.global.backup.gitlab.extraArgs is defined %}
        extraArgs: "{{ dsc.global.backup.gitlab.extraArgs }}"
{% else %}
        extraArgs: "{{ '--skip artifacts' if gitlab_backup_external_storage else '' }}"
{% endif %}
        # A long backup must not be killed by the next schedule, nor retried from scratch in a loop.
        concurrencyPolicy: Forbid
        backoffLimit: {{ dsc.global.backup.gitlab.backoffLimit | default(1) }}
{% if gitlab_backup_external_storage %}
        # Backup temporary data on a dedicated ephemeral volume instead of the node disk (emptyDir).
        persistence:
          enabled: true
          useGenericEphemeralVolume: true
          size: {{ dsc.global.backup.gitlab.tmpVolumeSize | default('30Gi') }}
{% endif %}
{% endif %}
{# Chart 10 requires a backup object storage config for the toolbox, even when backups are disabled #}
{% if dsc.global.backup.gitlab.enabled or (dsc.global.bucketPrefix | default('', true) | trim) %}
      objectStorage:
        config:
          secret: gitlab-backup
          key: config
{% endif %}

global:
  redis:
    host: gitlab-valkey
    port: 6379
    auth:
      enabled: true
      secret: gitlab-valkey
      key: password
  psql:
    # Chart 10 requires global.psql.host (serviceName was only used for the bundled PostgreSQL).
    # Same resolved host as before: <serviceName>.<release namespace>.svc
    host: pooler-pg-cluster-gitlab-rw.{{ dsc.gitlab.namespace }}.svc
    port: 5432
    database: gitlabhq_production
    username: gitlab
    password:
      secret: pg-cluster-gitlab-app
      key: password
  registry:
    enabled: false
  hosts:
    domain: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#rootDomain>
    registry:
      name: gitlab-registry.example.com
    kas:
      name: "{{ dsc_name }}-kas.<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#rootDomain>"
{% if gitlab_domain %}
    gitlab:
      name: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#domain | jsonPath {.gitlab}>
{% endif %}

  appConfig:
    defaultProjectsFeatures:
      containerRegistry: false
    ldap:
      preventSignin: true
    omniauth:
      enabled: true
      syncProfileAttributes: ["email"]
      allowSingleSignOn: ["openid_connect"]
      blockAutoCreatedUsers: false
      autoSignInWithProvider: "openid_connect"
      autoLinkLdapUser: false
      autoLinkSamlUser: false
      autoLinkUser: ["openid_connect"]
      providers:
        - secret: openid-connect
{% if dsc.global.backup.gitlab.enabled %}
    backups:
      bucket: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3BucketName}>
{% endif %}

  extraEnv:
    GITLAB_ROOT_EMAIL: "admin@example.com"

prometheus:
  install: false

postgresql:
  install: false

redis:
  install: false
