{# s3cmd config used by the toolbox backup-utility when dsc.gitlab.s3ObjectStorage
   is enabled and dsc.global.backup.gitlab is not (otherwise the toolbox keeps
   the gitlab-backup Secret). Without it the toolbox falls back to the bundled
   MinIO credentials, which no longer exist. #}
{% if dsc.gitlab.s3ObjectStorage.enabled | default(false) and not dsc.global.backup.gitlab.enabled %}
{% set gitlab_s3_host = dsc.gitlab.s3ObjectStorage.endpoint | regex_replace('^https?://', '') | regex_replace('/+$', '') %}
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-object-storage-s3cfg
type: Opaque
stringData:
  config: |
    [default]
    access_key = <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/gitlab/values#gitlab | jsonPath {.s3ObjectStorage.accesskey}>
    secret_key = <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/gitlab/values#gitlab | jsonPath {.s3ObjectStorage.secretkey}>
    bucket_location = {{ dsc.gitlab.s3ObjectStorage.region }}
    host_base = {{ gitlab_s3_host }}
{% if dsc.gitlab.s3ObjectStorage.pathStyle | default(true) | bool %}
    host_bucket = {{ gitlab_s3_host }}
{% else %}
    host_bucket = %(bucket)s.{{ gitlab_s3_host }}
{% endif %}
    use_https = {{ 'False' if dsc.gitlab.s3ObjectStorage.endpoint is match('http://') else 'True' }}
    signature_v2 = False
    multipart_chunk_size_mb = 128
{% if dsc.proxy.enabled %}
    proxy_host = http://<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#proxy | jsonPath {.hostProxy}>
    proxy_port = <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#proxy | jsonPath {.portProxy}>
{% endif %}
{% endif %}
