{% if dsc.global.backup.gitlab.enabled %}
apiVersion: batch/v1
kind: CronJob
metadata:
  name: gitlab-backup
spec:
  schedule: "0 1 * * *"
  jobTemplate:
    spec:
      template:
        spec:
          containers:
          - name: gitlab-backup-helper
            image: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#image | jsonPath {.repository.docker}>/rclone/rclone:latest
            env:
            - name: RCLONE_CONFIG
              value: "/tmp/rclone.conf"
            - name: RCLONE_CONFIG_BACKUP_TYPE
              value: "s3"
            - name: RCLONE_CONFIG_BACKUP_PROVIDER
              value: "Other"
            - name: RCLONE_CONFIG_BACKUP_FORCE_PATH_STYLE
              value: "true"
            - name: RCLONE_CONFIG_BACKUP_ENDPOINT
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3Endpoint}>"
            - name: RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3AccessKey}>"
            - name: RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3SecretKey}>"
{% if dsc.global.platform == "openshift" %}
            - name: RCLONE_NO_CHECK_CERTIFICATE
              value: "true"
{% endif %}
            - name: S3_BUCKET_NAME
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3BucketName}>"
            - name: S3_PATH_PREFIX
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.gitlab.pathPrefix}>"
            - name: RETENTION
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.gitlab.retentionPolicy}>"
            - name: RCLONE_EXTRA_ARGS
              value: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.gitlab.mcExtraArgs}>"
            command:
            - /bin/sh
            - -c
            - |
              set -eu
              BUCKET="${S3_BUCKET_NAME%/}"
              PREFIX="${S3_PATH_PREFIX%/}"

              # The GitLab toolbox drops its dumps at the bucket root, move them under the
              # prefix. Filter rules are first match wins: the destination has to be ruled
              # out first, otherwise rclone refuses to move between overlapping remotes.
              if [ -n "${PREFIX}" ]; then
                rclone move "backup:${BUCKET}" "backup:${BUCKET}/${PREFIX}" \
                  --filter "- ${PREFIX}/**" \
                  --filter "+ **gitlab_backup**" \
                  --filter "- **" \
                  -v ${RCLONE_EXTRA_ARGS}
              fi

              if [ -n "${RETENTION}" ]; then
                rclone delete "backup:${BUCKET}/${PREFIX}" \
                  --min-age "${RETENTION}" --rmdirs -v ${RCLONE_EXTRA_ARGS}
              fi
          restartPolicy: Never
{% endif %}
