keycloakx:
  # dsc.keycloakx.subDomain is "keycloakx" (temporary) at this stage, not
  # "keycloak" - this drives the codecentric chart's fullname, and therefore
  # its Service name ("<fullname>-http" -> "keycloakx-http"), distinct from
  # the legacy Service. Repointing this to the production "keycloak" name is
  # runbook step 5 (cutover) - see skill §5 for the Service-rename/
  # cert-manager pitfalls that step carries, and do it as its own deliberate
  # action once legacy is actually being retired, not before.
  fullnameOverride: {{ dsc.keycloakx.subDomain }}
  replicas: {{ dsc.keycloakx.replicas }}
  command:
    - /opt/keycloak/bin/kc.sh
  args:
    - start
  image:
    pullPolicy: IfNotPresent
  http:
    relativePath: "/"
  proxy:
    enabled: true
    mode: xforwarded
    http:
      enabled: true
  cache:
    stack: default
  metrics:
    enabled: {{ dsc.global.metrics.enabled | lower }}
  health:
    enabled: true
  resources:
    limits:
      memory: "2048Mi"
    requests:
      memory: "1024Mi"
  networkPolicy:
    enabled: false

  database:
    vendor: postgres
    hostname: pg-cluster-keycloak-rw
    port: 5432
    database: keycloak
    existingSecret: pg-cluster-keycloak-app
    existingSecretUserKey: username
    existingSecretPasswordKey: password

  extraEnvFrom: |
    - secretRef:
        name: keycloakx-admin-secret

  extraEnv: |
    - name: KC_LOG_LEVEL
      value: INFO
    - name: KC_HOSTNAME
      # Temporary host - dsc.keycloakx.subDomain ("keycloakx"), NOT the
      # production "keycloak" host that the legacy Ingress already owns.
      # Switching this to the production domain is runbook step 4/5
      # (cutover), a separate deliberate action - not something to do at
      # initial parallel deployment, see skill §5 for why (Ingress/Service
      # rename pitfalls) and this file's ingress.rules.host below.
      value: https://<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#domain | jsonPath {.keycloakx}>
    - name: DSFR_THEME_HOME_URL
      value: https://<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#domain | jsonPath {.console}>
    - name: DSFR_THEME_SERVICE_TITLE
      value: Cloud Pi Native
    - name: DSFR_THEME_BRAND_TOP
      value: "Ministere<br/>de l'interieur"
    - name: DSFR_THEME_CONTACT_EMAIL
      value: cloudpinative-relations@interieur.gouv.fr

  extraInitContainers: |
    - name: realm-ext-provider
      image: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#image | jsonPath {.repository.docker}>/curlimages/curl:8.12.1"
      imagePullPolicy: IfNotPresent
      command:
        - sh
      args:
        - -c
        - |
          mkdir -p /providers && \
          curl -k -fsSL -o /providers/keycloak-theme-dsfr.jar <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/keycloakx/values#initcontainers | jsonPath {.pluginDownloadUrl}> && \
          curl -k -fsSL -o /providers/keycloak-franceconnect.jar <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/keycloakx/values#initcontainers | jsonPath {.providerDownloadUrl}>
      volumeMounts:
        - name: providers
          mountPath: /providers
{% if dsc.proxy.enabled %}
      env:
        - name: HTTP_PROXY
          value: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#proxy | jsonPath {.httpProxy}>
        - name: HTTPS_PROXY
          value: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#proxy | jsonPath {.httpsProxy}>
        - name: NO_PROXY
          value: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#proxy | jsonPath {.noProxy}>
{% endif %}

  extraVolumes: |
    - name: providers
      emptyDir: {}

  extraVolumeMounts: |
    - name: providers
      mountPath: /opt/keycloak/providers

  ingress:
    enabled: true
    ingressClassName: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#ingressClassName>
    servicePort: http
    annotations:
{% for key, val in dsc.ingress.annotations.items() %}
      {{ key }}: "{{ val }}"
{% endfor %}
      route.openshift.io/termination: "edge"
    labels:
      app: keycloakx
{% for key, val in dsc.ingress.labels.items() %}
      {{ key }}: "{{ val }}"
{% endfor %}
    rules:
      # Temporary host ("keycloakx.<domain>"), NOT the production
      # "keycloak.<domain>" host the legacy Ingress already owns - claiming
      # that host now, before any cutover was decided, would collide with
      # the live legacy Ingress (and its cert-manager Certificate, see
      # skill §5). Repointing to the production host is a separate,
      # deliberate cutover step, not part of initial parallel deployment.
      - host: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#domain | jsonPath {.keycloakx}>
        paths:
          - path: /
            pathType: Prefix
{% if dsc.global.environment == "production" %}
          - path: /admin/
            pathType: Prefix
            serviceName: forbidden
            servicePort: http
          - path: /realms/{{ dsc.keycloakx.managementRealm }}/
            pathType: Prefix
            serviceName: forbidden
            servicePort: http
{% endif %}
{% if dsc.global.imagePullSecrets is defined %}
  imagePullSecrets: {{ dsc.global.imagePullSecrets | to_json }}
{% endif %}
