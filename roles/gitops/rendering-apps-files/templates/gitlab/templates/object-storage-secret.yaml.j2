{# Fog connection for GitLab consolidated object storage (dsc.gitlab.s3ObjectStorage).
   Keys come from Vault (apps/gitlab/values#gitlab.s3ObjectStorage) through AVP. #}
{% if dsc.gitlab.s3ObjectStorage.enabled | default(false) %}
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-object-storage
type: Opaque
stringData:
  connection: |
    provider: AWS
    region: "{{ dsc.gitlab.s3ObjectStorage.region }}"
    endpoint: "{{ dsc.gitlab.s3ObjectStorage.endpoint }}"
    path_style: {{ dsc.gitlab.s3ObjectStorage.pathStyle | default(true) | bool | lower }}
    aws_access_key_id: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/gitlab/values#gitlab | jsonPath {.s3ObjectStorage.accesskey}>"
    aws_secret_access_key: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/gitlab/values#gitlab | jsonPath {.s3ObjectStorage.secretkey}>"
{% endif %}
{# Same Secret name, other layout (key config): global.bucketPrefix flavour, only when
   dsc.gitlab.s3ObjectStorage is off (both would render the same Secret). #}
{% if dsc.global.bucketPrefix | default('', true) | trim and not (dsc.gitlab.s3ObjectStorage.enabled | default(false)) %}
apiVersion: v1
stringData:
  config: |
    provider: AWS
    region: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3Region}>"
    aws_access_key_id: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3AccessKey}>"
    aws_secret_access_key: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3SecretKey}>"
    endpoint: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3Endpoint}>"
    path_style: true
kind: Secret
metadata:
  annotations:
    avp.kubernetes.io/remove-missing: "true"
  name: gitlab-object-storage
type: Opaque
{% endif %}
