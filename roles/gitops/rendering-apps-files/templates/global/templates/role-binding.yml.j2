{% if (dsc.global.backup.s3.endpointCA | default({})).namespace is defined %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ dsc_name }}-bind-access-cnpg-s3-ca-secret
  namespace: {{ dsc.global.backup.s3.endpointCA.namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ dsc_name }}-access-cnpg-s3-ca-secret
subjects:
  - kind: ServiceAccount
    name: cpn-ansible-job
    namespace: {{ dsc.gitlab.namespace }}
{% endif %}
