cluster:
  # Disabled during the parallel phase: the Cluster is still owned by the legacy
  # `keycloak` app (automated prune). Only flip to true after the legacy app is
  # removed from envs.yaml AND the Cluster is confirmed alive - see the
  # keycloak-bitnami-migration runbook §7 (two real incidents). No recovery
  # bootstrap here: keycloakx adopts the existing Cluster, it does not recreate it.
  enabled: false

  nameOverride: "pg-cluster-keycloak"
  fullnameOverride: "pg-cluster-keycloak"
  cluster:
    # Prune=false: no prune on ownership change. Delete=false: no cascade delete if
    # the Application is removed (runbook §7). Same value as the legacy app.
    annotations:
      argocd.argoproj.io/sync-options: Prune=false,Delete=false
    primaryUpdateMethod: restart
    enablePDB: false
    imageName: "<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#image | jsonPath {.repository.ghcr}>/{{ dsc.keycloakx.cnpg.imageName }}"
{% if dsc.global.imagePullSecrets is defined %}
    imagePullSecrets: {{ dsc.global.imagePullSecrets | to_json }}
{% endif %}
    initdb:
      owner: "keycloak"
      database: "keycloak"

    storage:
      size: {{ dsc.keycloakx.postgresPvcSize }}
{% if dsc.keycloakx.postgresWalPvcSize is defined %}
    walStorage:
      enabled: true
      size: {{ dsc.keycloakx.postgresWalPvcSize }}
{% endif %}

    postgresql:
      parameters:
        max_worker_processes: "60"
{% if dsc.keycloakx.postgresWalMaxSlotKeepSize is defined %}
        max_slot_wal_keep_size: {{ dsc.keycloakx.postgresWalMaxSlotKeepSize }}
{% endif %}
      pg_hba:
        - host keycloak keycloak all md5
        - host keycloak streaming_replica all md5

    monitoring:
      enabled: {{ dsc.global.metrics.enabled }}

{% if dsc.global.backup.cnpg.enabled %}
  # Same destination as the legacy app: on adoption the Cluster spec must not
  # change (a different backup path here = real drift on the live Cluster).
  backups:
    destinationPath: s3://<path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3BucketName}>/cnpg
    enabled: true
    endpointURL: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3Endpoint}>
    retentionPolicy: 14d
    s3:
      accessKey: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3AccessKey}>
      secretKey: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3SecretKey}>
    scheduledBackups:
    - name: pg-cluster-keycloak
      schedule: 0 0 */6 * * *
      backupOwnerReference: self
      method: barmanObjectStore
{% if dsc.global.backup.s3.endpointCA is defined %}
    endpointCA:
      create: true
      name: {{ dsc.global.backup.s3.endpointCA.name }}
      key: {{ dsc.global.backup.s3.endpointCA.key }}
      value: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#cnpgS3CaPem>
{% endif %}
{% endif %}
