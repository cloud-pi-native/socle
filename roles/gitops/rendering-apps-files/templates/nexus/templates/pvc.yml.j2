---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nexus-data-proxy-cache
  namespace: {{ dsc.nexus.namespace }}
  labels:
    app.kubernetes.io/component: repository
    app.kubernetes.io/instance: nexus
    app.kubernetes.io/name: nexus3
spec:
  accessModes:
    - ReadWriteOnce
{% if dsc.global.storageClass is defined %}
  storageClassName: {{ dsc.global.storageClass }}
{% endif %}
  resources:
    requests:
      storage: {{ dsc.nexus.proxyCacheSize }}
