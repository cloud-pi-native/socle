{% if dsc.global.backup.velero.enabled | default(false) %}
{% set velero_retention = dsc.global.backup.velero.retentionPolicy | default('14d') %}
dso-backup:
  global:
    appName: vault
  strategy: vault
  velero:
{% if dsc.velero.installEnabled | default(false) %}
    namespace: {{ dsc.velero.namespace }}
    storageLocation: {{ dsc.velero.storageLocationName | default('default') }}
{% endif %}
    backupNamePrefix: socle
    ttl: {{ ((velero_retention[:-1] | int) * 24 ~ 'h' if velero_retention.endswith('d') else velero_retention) | quote }}
{% if dsc.velero.installEnabled | default(false) %}
    volumes:
      # Vault data is protected by the raft snapshot sent to S3 by the pre-hook; without a node agent,
      # file system backup of the volumes would make every Velero backup PartiallyFailed.
      defaultVolumesToFsBackup: {{ dsc.velero.nodeAgent.enabled | default(false) | lower }}
{% endif %}
  vault:
    s3:
      bucket: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3BucketName}>
      endpoint: <path:{{ vaultinfra_kv_name }}/data/env/{{ dsc_name }}/apps/global/values#backup | jsonPath {.s3Endpoint}>
      forcePathStyle: true
      credentialsSecret: vault-backup-s3-credentials
      insecure: true
    tokenSecret:
      name: {{ dsc_name }}-vault-keys
      key: root_token
  application:
    workloads:
      - type: deployment
        name: {{ dsc_name }}-vault-agent-injector
        replicas: 1
        podLabelSelector:
          app.kubernetes.io/instance: {{ dsc.global.gitOps.envName }}-{{ dsc.vault.namespace }}
          app.kubernetes.io/name: vault-agent-injector
          component: webhook
        shutdownTimeout: 120
{% endif %}
